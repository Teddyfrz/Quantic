// Quantic — schéma de données. SQLite pour le développement local.
// Les modules métier (projets, tâches, notes, etc.) seront ajoutés par lots.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./quantic.db"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user") // "user" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invitationsCreated InvitationCode[] @relation("CreatedInvitations")
  projects           Project[]
  tasks              Task[]
  notes              Note[]
  kbCategories       KbCategory[]
  kbPages            KbPage[]
  events             CalendarEvent[]
  contacts           Contact[]
  trackingEntries    TrackingEntry[]
  healthEntries      HealthEntry[]
  sportSessions      SportSession[]
  transactions       Transaction[]
  budgets            Budget[]
  profile            Profile?
}

// --- Profil social (annuaire des membres) ---

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String?  @unique
  bio         String?
  status      String   @default("available") // available | focus | away | offline
  statusText  String?
  location    String?
  avatarColor String   @default("0")
  avatarUrl   String? // data URL (image redimensionnée côté client)
  bannerUrl   String? // data URL
  links       String   @default("[]") // JSON: string[]
  visibility  String   @default("members") // "private" | "members"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String   @default("active") // "active" | "paused" | "done"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks  Task[]
  notes  Note[]
  events CalendarEvent[]

  @@index([userId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

// --- Base de connaissances (distincte des Notes) ---

model KbCategory {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages KbPage[]

  @@index([userId])
}

model KbPage {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  title      String
  content    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category KbCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoryId])
}

// --- Calendrier ---

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startAt])
}

// --- Contacts ---

// --- Personnel : Suivi quotidien ---

model TrackingEntry {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime // jour (00:00 UTC) ; une entrée par jour
  mental     Int? // 1-5
  energy     Int? // 1-5
  stress     Int? // 1-5
  sleepHours Float? // heures de sommeil
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

// --- Personnel : Santé ---

model HealthEntry {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime // jour (00:00 UTC) ; une entrée par jour
  weight      Float? // kg
  water       Int? // quantité (ml)
  waterGoal   Int? // objectif (ml)
  bodyFeeling String? // ressenti libre / sélection douce
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model SportSession {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  activity    String
  durationMin Int
  intensity   String? // "low" | "medium" | "high"
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

// --- Personnel : Finance ---

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float // toujours positif ; le type donne le sens
  type      String // "income" | "expense"
  category  String
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  category  String? // null = budget global
  amount    Float // montant prévu (mensuel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contact {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  type      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  projectId   String?
  title       String
  description String?
  status      String    @default("todo") // "todo" | "doing" | "done"
  priority    String? // "low" | "medium" | "high"
  dueDate     DateTime?
  recurrence  String? // "daily" | "weekly" | "monthly" (null = aucune)
  tags        String    @default("[]") // JSON: string[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

model InvitationCode {
  id              String    @id @default(cuid())
  code            String    @unique
  createdByUserId String?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdBy User? @relation("CreatedInvitations", fields: [createdByUserId], references: [id])
}
